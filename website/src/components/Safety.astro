---
const rules = [
  {
    title: 'Scanning is read-only',
    body: 'Git runs with GIT_OPTIONAL_LOCKS=0, so Grove never takes the index lock out from under your editor or terminal.',
  },
  {
    title: 'Worktrees come back exactly',
    body: 'Removing a worktree also sets aside git’s record of it, so undo puts it back as it was. Those records are cleared after a week.',
  },
  {
    title: 'Repositories list what they take',
    body: 'Removing a repository takes its linked worktrees with it, and the confirmation names every one.',
  },
  {
    title: 'Unsaved work is called out first',
    body: 'Uncommitted changes, unpushed commits, stashes or no remote at all: you see it before you confirm.',
  },
  {
    title: 'Branches in use are off limits',
    body: 'Branch cleanup never touches the default branch, the current branch, or one checked out in any worktree. Deleted branches come back with ⌘Z.',
  },
  {
    title: 'Pins stay put',
    body: 'Pin a repository to keep it in the sidebar and out of every cleanup suggestion.',
  },
  {
    title: 'The network waits for you',
    body: 'Fetch All is the only network action, and it only runs when you click it.',
  },
];

const keys: [string[], string][] = [
  [['⌘', 'R'], 'Refresh'],
  [['⌥', '⌘', 'R'], 'Fetch all remotes'],
  [['⌘', 'O'], 'Open in editor'],
  [['⇧', '⌘', 'T'], 'Open in terminal'],
  [['⇧', '⌘', 'R'], 'Show in Finder'],
  [['⇧', '⌘', 'B'], 'Open remote in browser'],
  [['⌘', '⌫'], 'Move to Trash'],
  [['⌘', 'Z'], 'Undo the last removal'],
  [['⌥', '⌘', 'I'], 'Show or hide the inspector'],
];
---

<section id="safety" class="sheet sheet-paper" aria-labelledby="safety-title">
  <div class="wrap sheet-body">
    <h2 id="safety-title">Nothing goes without a way back.</h2>
    <p class="promise">
      Removing moves things to the real Trash, so Finder’s Put Back works, and <kbd>⌘</kbd><kbd>Z</kbd> undoes it.
    </p>

    <dl class="rules">
      {
        rules.map((r) => (
          <div>
            <dt>{r.title}</dt>
            <dd>{r.body}</dd>
          </div>
        ))
      }
    </dl>

    <div class="keys">
      <h3>From the keyboard</h3>
      <ul>
        {
          keys.map(([combo, action]) => (
            <li>
              <span class="combo">
                {combo.map((k) => (
                  <kbd>{k}</kbd>
                ))}
              </span>
              <span>{action}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  h2 {
    max-width: 14em;
  }

  .promise {
    margin-top: calc(var(--m) * 0.75);
    max-width: 24em;
    font-size: clamp(1.35rem, 1rem + 1.1vw, 2rem);
    line-height: 1.3;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }

  .promise kbd {
    font-size: 0.72em;
    vertical-align: 0.12em;
    margin-inline: 0.06em;
  }

  .rules {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--m);
    margin-top: calc(var(--m) * 2);
    border-top: 1px solid var(--fg);
  }

  .rules div {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 8fr);
    gap: 1rem;
    padding-block: max(14px, calc(var(--m) * 0.45));
    border-bottom: 1px solid var(--line-strong);
  }

  dt {
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  dd {
    margin: 0;
    color: var(--fg-2);
    text-wrap: pretty;
  }

  .keys {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 23fr);
    gap: var(--m);
    margin-top: calc(var(--m) * 2.5);
  }

  h3 {
    font-size: 1.2rem;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .keys ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem var(--m);
  }

  .keys li {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--fg-2);
    font-size: 0.95rem;
  }

  .combo {
    display: inline-flex;
    flex: none;
    width: 6.4em;
  }

  .combo kbd + kbd {
    margin-left: -1px;
  }

  @media (max-width: 960px) {
    .rules {
      grid-template-columns: minmax(0, 1fr);
    }

    .keys {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }

    .keys ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .rules div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }

    .keys ul {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
